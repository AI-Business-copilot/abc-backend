  rejectedAt          DateTime? @map("rejected_at") @db.Timestamptz(6)
  /// SQL CHECK (rejection_reason_code IN ('WRONG_QUANTITY', 'PHOTO_UNCLEAR', 'NOT_REMOVED_FROM_SHELF', 'OTHER')).
  rejectionReasonCode String?   @map("rejection_reason_code") @db.VarChar(40)
  rejectionNote       String?   @map("rejection_note") @db.VarChar(500)

  business       Business          @relation("scrap_orders_business_id", fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  variant        ProductVariant    @relation("scrap_orders_variant_id", fields: [variantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lotItem        ProductLotItem?   @relation("scrap_orders_lot_item_id", fields: [lotItemId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdByUser  User              @relation("scrap_orders_created_by", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  approvedByUser User?             @relation("scrap_orders_approved_by", fields: [approvedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  rejectedByUser User?             @relation("scrap_orders_rejected_by", fields: [rejectedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  images         ScrapOrderImage[] @relation("scrap_order_images_scrap_order_id")

  @@unique([businessId, scrapCode], map: "uq_scrap_tenant_code")
  @@map("scrap_orders")
}

