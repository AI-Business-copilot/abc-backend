// Nguon: hop nhat schema auth/RBAC (remote) voi schema nghiep vu 40 bang.
// Auth/RBAC dung dung thiet ke Supabase; khoi san pham bo sung module quan ly hang hoa.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes", "views"]
}

datasource db {
  provider = "postgresql"
}

model Business {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String    @db.VarChar(255)
  phone        String    @db.VarChar(20)
  address      String?   @db.Text
  industryType String    @map("industry_type") @db.VarChar(50)
  status       String    @default("ACTIVE") @db.VarChar(20)
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships BusinessMembership[]
  invitations BusinessInvitation[]
  auditLogs   PlatformAuditLog[]
  roles       Role[]

  categories          Category[]           @relation("categories_business_id")
  categoryAttributes  CategoryAttribute[]  @relation("category_attributes_business_id")
  productTemplates    ProductTemplate[]    @relation("product_templates_business_id")
  attributes          Attribute[]          @relation("attributes_business_id")
  attributeValues     AttributeValue[]     @relation("attribute_values_business_id")
  productVariants     ProductVariant[]     @relation("product_variants_business_id")
  suppliers           Supplier[]           @relation("suppliers_business_id")
  supplierProducts    SupplierProduct[]    @relation("supplier_products_business_id")
  customers           Customer[]           @relation("customers_business_id")
  productLots         ProductLot[]         @relation("product_lots_business_id")
  productLotItems     ProductLotItem[]     @relation("product_lot_items_business_id")
  inventoryBalances   InventoryBalance[]   @relation("inventory_balances_business_id")
  inventoryLedger     InventoryLedger[]    @relation("inventory_ledger_business_id")
  openingStockSheets  OpeningStockSheet[]  @relation("opening_stock_sheets_business_id")
  purchaseOrders      PurchaseOrder[]      @relation("purchase_orders_business_id")
  purchaseReceipts    PurchaseReceipt[]    @relation("purchase_receipts_business_id")
  vendorReturns       VendorReturn[]       @relation("vendor_returns_business_id")
  cashShifts          CashShift[]          @relation("cash_shifts_business_id")
  cashTransactions    CashTransaction[]    @relation("cash_transactions_business_id")
  cashShiftHandoffs   CashShiftHandoff[]   @relation("cash_shift_handoffs_business_id")
  cashShiftHandoffReviews CashShiftHandoffReview[] @relation("cash_shift_handoff_reviews_business_id")
  cashShiftCloseReviews CashShiftCloseReview[] @relation("cash_shift_close_reviews_business_id")
  orders              Order[]              @relation("orders_business_id")
  customerReturns     CustomerReturn[]     @relation("customer_returns_business_id")
  stockAudits         StockAudit[]         @relation("stock_audits_business_id")
  scrapOrders         ScrapOrder[]         @relation("scrap_orders_business_id")
  scrapOrderImages    ScrapOrderImage[]    @relation("scrap_order_images_business_id")
  dailyProductMetrics DailyProductMetric[] @relation("daily_product_metrics_business_id")
  forecastRuns        ForecastRun[]        @relation("forecast_runs_business_id")
  promotions                 Promotion[]         @relation("promotions_business_id")
  promotionTargets           PromotionTarget[]    @relation("promotion_targets_business_id")
  promotionRedemptions       PromotionRedemption[] @relation("promotion_redemptions_business_id")

  @@map("businesses")
}

model User {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authUserId String    @unique(map: "uq_users_auth_user_id") @map("auth_user_id") @db.Uuid
  email      String    @unique(map: "uq_users_email") @db.VarChar(320)
  fullName   String    @map("full_name") @db.VarChar(150)
  status     String    @default("ACTIVE") @db.VarChar(20)
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships     BusinessMembership[]
  platformRoles   PlatformUserRole[]
  sentInvitations BusinessInvitation[] @relation("business_invitations_invited_by")
  auditLogs       PlatformAuditLog[]   @relation("platform_audit_actor")

  inventoryLedger            InventoryLedger[]   @relation("inventory_ledger_created_by")
  openingStockSheets         OpeningStockSheet[] @relation("opening_stock_sheets_created_by")
  purchaseOrders             PurchaseOrder[]     @relation("purchase_orders_created_by")
  purchaseReceipts           PurchaseReceipt[]   @relation("purchase_receipts_created_by")
  vendorReturns              VendorReturn[]      @relation("vendor_returns_created_by")
  cashShifts                 CashShift[]         @relation("cash_shifts_user_id")
  cashTransactions           CashTransaction[]   @relation("cash_transactions_created_by")
  cashShiftHandoffsRecorded CashShiftHandoff[] @relation("cash_shift_handoffs_recorded_by")
  cashShiftHandoffsReviewed CashShiftHandoff[] @relation("cash_shift_handoffs_reviewed_by")
  cashShiftHandoffReviewsSubmitted CashShiftHandoffReview[] @relation("cash_shift_handoff_reviews_submitted_by")
  cashShiftHandoffReviewsReviewed CashShiftHandoffReview[] @relation("cash_shift_handoff_reviews_reviewed_by")
  cashShiftReviewsSubmitted CashShiftCloseReview[] @relation("cash_shift_close_reviews_submitted_by")
  cashShiftReviewsReviewed CashShiftCloseReview[] @relation("cash_shift_close_reviews_reviewed_by")
  orders                     Order[]             @relation("orders_cashier_id")
  customerReturns            CustomerReturn[]    @relation("customer_returns_cashier_id")
  stockAudits                StockAudit[]        @relation("stock_audits_approved_by")
  stockAuditsCreated         StockAudit[]        @relation("stock_audits_created_by")
  stockAuditItemsCreatedBy   StockAuditItem[]    @relation("stock_audit_items_created_by_user_id")
  stockAuditItemsAssignedTo  StockAuditItem[]    @relation("stock_audit_items_assigned_to_user_id")
  stockAuditItemsSubmittedBy StockAuditItem[]    @relation("stock_audit_items_submitted_by_user_id")
  stockAuditItemsApprovedBy  StockAuditItem[]    @relation("stock_audit_items_approved_by_user_id")
  stockAuditItemsRejectedBy  StockAuditItem[]    @relation("stock_audit_items_rejected_by_user_id")
  scrapOrders                ScrapOrder[]        @relation("scrap_orders_created_by")
  scrapOrdersApproved        ScrapOrder[]        @relation("scrap_orders_approved_by")
  scrapOrdersRejected        ScrapOrder[]        @relation("scrap_orders_rejected_by")
  scrapImagesUploaded        ScrapOrderImage[]   @relation("scrap_order_images_uploaded_by")
  scrapImagesDeleted         ScrapOrderImage[]   @relation("scrap_order_images_deleted_by")
  lotItemsQuarantined        ProductLotItem[]    @relation("product_lot_items_quarantined_by")
  forecastRuns               ForecastRun[]       @relation("forecast_runs_executed_by")
  promotionsCreated          Promotion[]         @relation("promotions_created_by")

  @@map("users")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique(map: "uq_roles_code") @db.VarChar(50)
  scope       String   @db.VarChar(20)
  displayName String   @map("display_name") @db.VarChar(100)
  description String?  @db.Text
  businessId  String?  @map("business_id") @db.Uuid
  isDefault   Boolean  @default(false) @map("is_default")
  isArchived  Boolean  @default(false) @map("is_archived")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  business      Business? @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  permissions   RolePermission[]
  memberships   BusinessMembership[]
  platformUsers PlatformUserRole[]
  invitations   BusinessInvitation[]

  @@unique([businessId, displayName], map: "uq_roles_business_display_name")
  @@index([businessId, scope, isArchived], map: "idx_roles_business_scope_archived")
  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique(map: "uq_permissions_code") @db.VarChar(100)
  scope       String   @db.VarChar(20)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model BusinessMembership {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  status     String   @default("ACTIVE") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  role     Role     @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([businessId, userId], map: "uq_business_memberships_business_user")
  @@unique([userId], where: raw("(status IN ('ACTIVE', 'SUSPENDED'))"), map: "uq_business_memberships_current_user")
  @@index([businessId, status], map: "idx_business_memberships_business_status")
  @@map("business_memberships")
}

model PlatformUserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([userId, roleId])
  @@map("platform_user_roles")
}

model BusinessInvitation {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId   String    @map("business_id") @db.Uuid
  invitedEmail String    @map("invited_email") @db.VarChar(320)
  roleId       String    @map("role_id") @db.Uuid
  invitedBy    String    @map("invited_by") @db.Uuid
  tokenHash    String    @unique(map: "uq_business_invitations_token_hash") @map("token_hash") @db.Char(64)
  status       String    @default("PENDING") @db.VarChar(20)
  emailStatus  String    @default("PENDING") @map("email_status") @db.VarChar(20)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt   DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  business      Business @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  role          Role     @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  invitedByUser User     @relation("business_invitations_invited_by", fields: [invitedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([businessId, invitedEmail], where: raw("(status = 'PENDING')"), map: "uq_business_invitations_pending_email")
  @@index([businessId, status], map: "idx_business_invitations_business_status")
  @@index([invitedEmail, status], map: "idx_business_invitations_email_status")
  @@map("business_invitations")
}

model PlatformAuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  businessId  String?  @map("business_id") @db.Uuid
  action      String   @db.VarChar(100)
  targetType  String   @map("target_type") @db.VarChar(50)
  targetId    String   @map("target_id") @db.Uuid
  changes     Json?    @db.JsonB
  reason      String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor    User      @relation("platform_audit_actor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([createdAt(sort: Desc)], map: "idx_platform_audit_logs_created_at")
  @@index([businessId, createdAt(sort: Desc)], map: "idx_platform_audit_logs_business_created_at")
  @@map("platform_audit_logs")
}

model Category {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String    @map("business_id") @db.Uuid
  name        String    @db.VarChar(150)
  code        String?   @db.VarChar(50)
  parentId    String?   @map("parent_id") @db.Uuid
  description String?   @db.Text
  isActive    Boolean?  @default(true) @map("is_active")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  business           Business            @relation("categories_business_id", fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  parent             Category?           @relation("categories_parent_id", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  children           Category[]          @relation("categories_parent_id")
  categoryAttributes CategoryAttribute[] @relation("category_attributes_category_id")
  productTemplates   ProductTemplate[]   @relation("product_templates_category_id")
  promotionTargets   PromotionTarget[]   @relation("promotion_targets_category_id")

  @@unique([businessId, name], map: "uq_category_tenant_name")
  @@unique([businessId, code], map: "uq_category_tenant_code")
  @@unique([businessId, id], map: "uq_category_tenant_id")
  @@map("categories")
}

model CategoryAttribute {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String    @map("business_id") @db.Uuid
  categoryId  String    @map("category_id") @db.Uuid
  attributeId String    @map("attribute_id") @db.Uuid
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  business  Business  @relation("category_attributes_business_id", fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  category  Category  @relation("category_attributes_category_id", fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  attribute Attribute @relation("category_attributes_attribute_id", fields: [attributeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([categoryId, attributeId], map: "uq_category_attribute")
  @@map("category_attributes")
}

model ProductTemplate {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId     String    @map("business_id") @db.Uuid
  name           String    @db.VarChar(255)
  categoryId     String?   @map("category_id") @db.Uuid
  unitOfMeasure  String?   @default("Cái") @map("unit_of_measure") @db.VarChar(50)
  description    String?   @db.Text
  code           String?   @db.VarChar(50)
  imageUrl       String?   @map("image_url") @db.Text
  hasLotTracking Boolean?  @default(false) @map("has_lot_tracking")
  isActive       Boolean?  @default(true) @map("is_active")
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  business        Business         @relation("product_templates_business_id", fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  category        Category?        @relation("product_templates_category_id", fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  productVariants ProductVariant[] @relation("product_variants_template_id")
  promotionTargets PromotionTarget[] @relation("promotion_targets_product_template_id")

  @@unique([businessId, name], map: "uq_template_tenant_name")
  @@unique([businessId, id], map: "uq_template_tenant_id")
  @@map("product_templates")
}

model Attribute {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  name       String    @db.VarChar(100)
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  business               Business                @relation("attributes_business_id", fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  attributeValues        AttributeValue[]        @relation("attribute_values_attribute_id")
  variantAttributeValues VariantAttributeValue[] @relation("variant_attribute_values_attribute_id")
  categoryAttributes     CategoryAttribute[]     @relation("category_attributes_attribute_id")

  @@unique([businessId, name], map: "uq_attribute_tenant_name")
  @@map("attributes")
}

model AttributeValue {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String    @map("business_id") @db.Uuid
  attributeId String    @map("attribute_id") @db.Uuid
  value       String    @db.VarChar(100)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  business               Business                @relation("attribute_values_business_id", fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  attribute              Attribute               @relation("attribute_values_attribute_id", fields: [attributeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  variantAttributeValues VariantAttributeValue[] @relation("variant_attribute_values_attribute_value_id")

  @@unique([attributeId, value], map: "uq_attribute_value")
  @@map("attribute_values")
}

model ProductVariant {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId       String    @map("business_id") @db.Uuid
  templateId       String    @map("template_id") @db.Uuid
  sku              String    @db.VarChar(100)
  barcode          String?   @db.VarChar(100)
  /// SQL CHECK (base_price >= 0); can ap dung bang SQL rieng.
  basePrice        Decimal   @map("base_price") @db.Decimal(12, 2)
  /// SQL CHECK (cost_price >= 0); can ap dung bang SQL rieng.
  costPrice        Decimal   @default(0) @map("cost_price") @db.Decimal(12, 2)
  /// SQL CHECK (lead_time_days >= 0); can ap dung bang SQL rieng.
  leadTimeDays     Int       @default(3) @map("lead_time_days")
  /// SQL CHECK (review_period_days > 0); can ap dung bang SQL rieng.
  reviewPeriodDays Int       @default(7) @map("review_period_days")
  /// SQL CHECK (safety_stock_qty >= 0); can ap dung bang SQL rieng.
  safetyStockQty   Int       @default(0) @map("safety_stock_qty")
  /// SQL CHECK (min_order_qty > 0); can ap dung bang SQL rieng.
  minOrderQty      Int       @default(1) @map("min_order_qty")
  /// SQL CHECK (pack_size > 0); can ap dung bang SQL rieng.
  packSize         Int       @default(1) @map("pack_size")
  isLockedForAudit Boolean   @default(false) @map("is_locked_for_audit")
  isActive         Boolean?  @default(true) @map("is_active")
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  business               Business                @relation("product_variants_business_id", fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  template               ProductTemplate         @relation("product_variants_template_id", fields: [templateId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  variantAttributeValues VariantAttributeValue[] @relation("variant_attribute_values_variant_id")
  productLotItems        ProductLotItem[]        @relation("product_lot_items_variant_id")
  inventoryBalances      InventoryBalance[]      @relation("inventory_balances_variant_id")
  inventoryLedger        InventoryLedger[]       @relation("inventory_ledger_variant_id")
  openingStockItems      OpeningStockItem[]      @relation("opening_stock_items_variant_id")
  purchaseOrderItems     PurchaseOrderItem[]     @relation("purchase_order_items_variant_id")
  purchaseReceiptItems   PurchaseReceiptItem[]   @relation("purchase_receipt_items_variant_id")
  vendorReturnItems      VendorReturnItem[]      @relation("vendor_return_items_variant_id")
  orderItems             OrderItem[]             @relation("order_items_variant_id")
  customerReturnItems    CustomerReturnItem[]    @relation("customer_return_items_variant_id")
  stockAuditItems        StockAuditItem[]        @relation("stock_audit_items_variant_id")
  scrapOrders            ScrapOrder[]            @relation("scrap_orders_variant_id")
  dailyProductMetrics    DailyProductMetric[]    @relation("daily_product_metrics_variant_id")
  forecastResults        ForecastResult[]        @relation("forecast_results_variant_id")

  supplierProducts SupplierProduct[] @relation("supplier_products_variant_id")

  @@unique([businessId, sku], map: "uq_variant_tenant_sku")
  @@unique([businessId, id], map: "uq_variant_tenant_id")
  @@unique([businessId, barcode], map: "uq_variant_tenant_barcode")
  @@map("product_variants")
}

model VariantAttributeValue {
  variantId        String @map("variant_id") @db.Uuid
  attributeId      String @map("attribute_id") @db.Uuid
  attributeValueId String @map("attribute_value_id") @db.Uuid

  variant        ProductVariant @relation("variant_attribute_values_variant_id", fields: [variantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  attribute      Attribute      @relation("variant_attribute_values_attribute_id", fields: [attributeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  attributeValue AttributeValue @relation("variant_attribute_values_attribute_value_id", fields: [attributeValueId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([variantId, attributeValueId])
  @@unique([variantId, attributeId], map: "uq_variant_single_attr_value")
  @@map("variant_attribute_values")
}

model Supplier {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId    String    @map("business_id") @db.Uuid
  name          String    @db.VarChar(255)
  phone         String?   @db.VarChar(20)
  contactPerson String?   @map("contact_person") @db.VarChar(100)
  supplierCode  String?   @map("supplier_code") @db.VarChar(50)
  email         String?   @db.VarChar(255)
  address       String?   @db.Text
  taxCode       String?   @map("tax_code") @db.VarChar(30)
  note          String?   @db.Text
  isActive      Boolean   @default(true) @map("is_active")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  debtAmount    Decimal?  @default(0) @map("debt_amount") @db.Decimal(12, 2)
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  business         Business          @relation("suppliers_business_id", fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  purchaseOrders   PurchaseOrder[]   @relation("purchase_orders_supplier_id")
  purchaseReceipts PurchaseReceipt[] @relation("purchase_receipts_supplier_id")
  vendorReturns    VendorReturn[]    @relation("vendor_returns_supplier_id")
  supplierProducts SupplierProduct[] @relation("supplier_products_supplier_id")

  @@unique([businessId, id], map: "uq_supplier_tenant_id")
  @@unique([businessId, supplierCode], map: "uq_supplier_tenant_code")
  @@unique([businessId, phone], map: "uq_supplier_tenant_phone")
  @@map("suppliers")
}

/// Prices and order quantities use the SKU inventory unit. CHECK constraints live in the SQL migration.
model SupplierProduct {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId          String   @map("business_id") @db.Uuid
  supplierId          String   @map("supplier_id") @db.Uuid
  variantId           String   @map("variant_id") @db.Uuid
  supplierSku         String?  @map("supplier_sku") @db.VarChar(100)
  supplierProductName String?  @map("supplier_product_name") @db.VarChar(255)
  supplyPrice         Decimal  @map("supply_price") @db.Decimal(12, 2)
  minOrderQty         Int      @default(1) @map("min_order_qty")
  orderMultiple       Int      @default(1) @map("order_multiple")
  leadTimeDays        Int?     @map("lead_time_days")
  isPreferred         Boolean  @default(false) @map("is_preferred")
  isActive            Boolean  @default(true) @map("is_active")
  priceUpdatedAt      DateTime @default(now()) @map("price_updated_at") @db.Timestamptz(6)
  note                String?  @db.Text
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business       @relation("supplier_products_business_id", fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  supplier Supplier       @relation("supplier_products_supplier_id", fields: [businessId, supplierId], references: [businessId, id], onDelete: Restrict, onUpdate: NoAction)
  variant  ProductVariant @relation("supplier_products_variant_id", fields: [businessId, variantId], references: [businessId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([businessId, supplierId, variantId], map: "uq_supplier_product_tenant_supplier_variant")
  @@unique([businessId, variantId], where: raw("(is_preferred = true AND is_active = true)"), map: "uq_supplier_product_preferred")
  @@index([businessId, supplierId, isActive], map: "idx_supplier_products_supplier_active")
  @@index([businessId, variantId, isActive], map: "idx_supplier_products_variant_active")
  @@map("supplier_products")
