  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  business Business @relation("ai_insight_settings_business_id", fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("ai_insight_settings")
}

model AiInsightRun {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String    @map("business_id") @db.Uuid
  /// MANUAL | SCHEDULED
  triggerType String    @map("trigger_type") @db.VarChar(20)
  /// RUNNING | SUCCEEDED | FAILED
  status      String    @db.VarChar(20)
  /// Last complete sales day included in the analysis (Asia/Ho_Chi_Minh).
  dataAsOf    DateTime  @map("data_as_of") @db.Date
  triggeredBy String?   @map("triggered_by") @db.Uuid
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(6)
  summary     Json?     @db.JsonB
  warnings    Json?     @db.JsonB
  error       String?   @db.Text

  business Business    @relation("ai_insight_runs_business_id", fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  insights AiInsight[] @relation("ai_insights_run_id")

  @@index([businessId, startedAt(sort: Desc)], map: "idx_ai_insight_runs_business_started")
  @@map("ai_insight_runs")
}

model AiInsight {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId      String    @map("business_id") @db.Uuid
  /// Last run that detected this insight.
  runId           String    @map("run_id") @db.Uuid
  /// LOW_STOCK | SLOW_MOVING | DECLINING_SALES | OVERSTOCK | EXPIRATION_RISK
  type            String    @db.VarChar(30)
  /// type:variantId:lotItemId - one live insight per fingerprint.
  fingerprint     String    @db.VarChar(160)
  variantId       String    @map("variant_id") @db.Uuid
  lotItemId       String?   @map("lot_item_id") @db.Uuid
  /// CRITICAL | HIGH | MEDIUM | LOW
  severity        String    @db.VarChar(10)
  reasonCode      String    @map("reason_code") @db.VarChar(60)
  suggestedAction String    @map("suggested_action") @db.VarChar(40)
  /// Inputs used by the rule, so every insight can be explained and audited.
  metrics         Json      @db.JsonB
  valueAtRisk     Decimal?  @map("value_at_risk") @db.Decimal(14, 2)
  priorityScore   Int       @map("priority_score")
  /// OPEN | ACKNOWLEDGED | DISMISSED | RESOLVED
  status          String    @default("OPEN") @db.VarChar(20)
  snoozeUntil     DateTime? @map("snooze_until") @db.Date
  handledBy       String?   @map("handled_by") @db.Uuid
  handledAt       DateTime? @map("handled_at") @db.Timestamptz(6)
  firstDetectedAt DateTime  @default(now()) @map("first_detected_at") @db.Timestamptz(6)
  lastDetectedAt  DateTime  @default(now()) @map("last_detected_at") @db.Timestamptz(6)
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(6)

  business Business        @relation("ai_insights_business_id", fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  run      AiInsightRun    @relation("ai_insights_run_id", fields: [runId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  variant  ProductVariant  @relation("ai_insights_variant_id", fields: [businessId, variantId], references: [businessId, id], onDelete: Cascade, onUpdate: NoAction)
  lotItem  ProductLotItem? @relation("ai_insights_lot_item_id", fields: [lotItemId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([businessId, fingerprint], map: "uq_ai_insights_fingerprint")
  @@index([businessId, status, severity], map: "idx_ai_insights_business_status")
  @@index([businessId, type, status], map: "idx_ai_insights_business_type")
  @@map("ai_insights")
}

