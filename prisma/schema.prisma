model StockAuditItem {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auditId                 String    @map("audit_id") @db.Uuid
  variantId               String    @map("variant_id") @db.Uuid
  lotItemId               String?   @map("lot_item_id") @db.Uuid
  snapshotQty             Int       @map("snapshot_qty")
  /// SQL CHECK (counted_qty >= 0); can ap dung bang SQL rieng.
  countedQty              Int       @map("counted_qty")
  /// SQL GENERATED ALWAYS AS (counted_qty - snapshot_qty) STORED; dbgenerated() chi danh dau gia tri do DB sinh.
  diffQty                 Int?      @default(dbgenerated()) @map("diff_qty")
  discrepancyReason       String?   @map("discrepancy_reason") @db.Text
  /// SQL CHECK (item_status IN ('IN_PROGRESS', 'PENDING_APPROVAL', 'APPROVED')); can ap dung bang SQL rieng.
  itemStatus              String    @default("IN_PROGRESS") @map("item_status") @db.VarChar(30)
  assignedToUserId        String?   @map("assigned_to_user_id") @db.Uuid
  submittedAt             DateTime? @map("submitted_at") @db.Timestamptz(6)
  submittedBy             String?   @map("submitted_by") @db.Uuid
  approvedAt              DateTime? @map("approved_at") @db.Timestamptz(6)
  approvedBy              String?   @map("approved_by") @db.Uuid
  /// Set when the owner sends a submitted item back for a recount. Cleared when the employee submits again.
  rejectionReason         String?   @map("rejection_reason") @db.Text
  rejectedAt              DateTime? @map("rejected_at") @db.Timestamptz(6)
  rejectedBy              String?   @map("rejected_by") @db.Uuid
  createdBy               String?   @map("created_by") @db.Uuid
  /// Lot number: autofilled from product_lot_items when lot_item_id is set; typed by the employee for a new lot.
  lotNumber               String?   @map("lot_number") @db.VarChar(100)
  /// Task type set by the owner: EXISTING (employee counts a lot already in the system) or NEW (employee types a new lot).
  /// The employee cannot switch between the two.
  lotMode                 String    @default("EXISTING") @map("lot_mode") @db.VarChar(20)
  newLotExpirationDate    DateTime? @map("new_lot_expiration_date") @db.Date
  newLotManufacturingDate DateTime? @map("new_lot_manufacturing_date") @db.Date

  audit           StockAudit      @relation("stock_audit_items_audit_id", fields: [auditId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  variant         ProductVariant  @relation("stock_audit_items_variant_id", fields: [variantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lotItem         ProductLotItem? @relation("stock_audit_items_lot_item_id", fields: [lotItemId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  assignedToUser  User?           @relation("stock_audit_items_assigned_to_user_id", fields: [assignedToUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  submittedByUser User?           @relation("stock_audit_items_submitted_by_user_id", fields: [submittedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  approvedByUser  User?           @relation("stock_audit_items_approved_by_user_id", fields: [approvedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  rejectedByUser  User?           @relation("stock_audit_items_rejected_by_user_id", fields: [rejectedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdByUser   User?           @relation("stock_audit_items_created_by_user_id", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("stock_audit_items")
}

model ScrapOrder {
