  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  business    Business             @relation("promotions_business_id", fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  creator     User                 @relation("promotions_created_by", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  targets     PromotionTarget[]    @relation("promotion_targets_promotion_id")
  redemptions PromotionRedemption[] @relation("promotion_redemptions_promotion_id")
  orders      Order[]              @relation("orders_promotion_id")

  @@unique([businessId, id], map: "uq_promotions_business_id")
  @@index([businessId, status, startsAt, endsAt], map: "idx_promotions_business_status_dates")
  @@map("promotions")
}

model PromotionTarget {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId       String  @map("business_id") @db.Uuid
  promotionId      String  @map("promotion_id") @db.Uuid
  targetType       String  @map("target_type") @db.VarChar(20)
  categoryId       String? @map("category_id") @db.Uuid
  productTemplateId String? @map("product_template_id") @db.Uuid

  business        Business         @relation("promotion_targets_business_id", fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  promotion       Promotion        @relation("promotion_targets_promotion_id", fields: [businessId, promotionId], references: [businessId, id], onDelete: Cascade, onUpdate: NoAction)
  category        Category?        @relation("promotion_targets_category_id", fields: [businessId, categoryId], references: [businessId, id], onDelete: Restrict, onUpdate: NoAction)
  productTemplate ProductTemplate? @relation("promotion_targets_product_template_id", fields: [businessId, productTemplateId], references: [businessId, id], onDelete: Restrict, onUpdate: NoAction)

  @@index([businessId, promotionId], map: "idx_promotion_targets_business_promotion")
  @@map("promotion_targets")
}

model PromotionRedemption {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId     String   @map("business_id") @db.Uuid
  promotionId    String   @map("promotion_id") @db.Uuid
  orderId        String   @unique(map: "uq_promotion_redemptions_order") @map("order_id") @db.Uuid
  discountAmount Decimal  @map("discount_amount") @db.Decimal(12, 2)
  redeemedAt     DateTime @default(now()) @map("redeemed_at") @db.Timestamptz(6)

  business  Business  @relation("promotion_redemptions_business_id", fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  promotion Promotion @relation("promotion_redemptions_promotion_id", fields: [businessId, promotionId], references: [businessId, id], onDelete: Restrict, onUpdate: NoAction)
  order     Order     @relation("promotion_redemptions_order_id", fields: [businessId, orderId], references: [businessId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([promotionId, orderId], map: "uq_promotion_redemptions_promotion_order")
  @@unique([businessId, orderId], map: "uq_promotion_redemptions_business_order")
  @@index([businessId, promotionId, redeemedAt], map: "idx_promotion_redemptions_business_date")
  @@map("promotion_redemptions")
}

model DailyProductMetric {
  businessId   String   @map("business_id") @db.Uuid
  variantId    String   @map("variant_id") @db.Uuid
  metricDate   DateTime @map("metric_date") @db.Date
  /// SQL CHECK (units_sold >= 0); can ap dung bang SQL rieng.
  unitsSold    Int      @default(0) @map("units_sold")
  netRevenue   Decimal  @default(0) @map("net_revenue") @db.Decimal(12, 2)
  netCogs      Decimal  @default(0) @map("net_cogs") @db.Decimal(12, 2)
  closingStock Int      @map("closing_stock")
  isStockout   Boolean  @default(false) @map("is_stockout")

  business Business       @relation("daily_product_metrics_business_id", fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  variant  ProductVariant @relation("daily_product_metrics_variant_id", fields: [variantId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([businessId, variantId, metricDate])
  @@map("daily_product_metrics")
}

model ForecastRun {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId        String    @map("business_id") @db.Uuid
  /// SQL CHECK (problem_type IN ('REORDER_7D_14D', 'SLOW_MOVING_EXCESS')); can ap dung bang SQL rieng.
  problemType       String    @map("problem_type") @db.VarChar(50)
  /// SQL CHECK (horizon_days IN (7, 14)); can ap dung bang SQL rieng.
  horizonDays       Int       @map("horizon_days")
  algorithmName     String    @map("algorithm_name") @db.VarChar(100)
  modelVersion      String    @map("model_version") @db.VarChar(50)
  trainingStartDate DateTime  @map("training_start_date") @db.Date
  trainingEndDate   DateTime  @map("training_end_date") @db.Date
  dataCutoffDate    DateTime  @map("data_cutoff_date") @db.Date
  forecastStartDate DateTime  @map("forecast_start_date") @db.Date
  forecastEndDate   DateTime  @map("forecast_end_date") @db.Date
  hyperparameters   Json?     @db.JsonB
  executedAt        DateTime? @default(now()) @map("executed_at") @db.Timestamptz(6)
  executedBy        String?   @map("executed_by") @db.Uuid

  business        Business         @relation("forecast_runs_business_id", fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  executedByUser  User?            @relation("forecast_runs_executed_by", fields: [executedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  forecastResults ForecastResult[] @relation("forecast_results_run_id")

  @@map("forecast_runs")
}

model ForecastResult {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId                 String    @map("run_id") @db.Uuid
  variantId             String    @map("variant_id") @db.Uuid
  currentStock          Int       @map("current_stock")
  /// SQL CHECK (predicted_demand_qty >= 0); can ap dung bang SQL rieng.
  predictedDemandQty    Int       @map("predicted_demand_qty")
  /// SQL CHECK (recommended_order_qty >= 0); can ap dung bang SQL rieng.
  recommendedOrderQty   Int       @default(0) @map("recommended_order_qty")
  /// SQL CHECK (risk_level IN ('LOW', 'MEDIUM', 'HIGH', 'CRITICAL')); can ap dung bang SQL rieng.
  riskLevel             String    @map("risk_level") @db.VarChar(20)
  /// SQL CHECK (owner_decision IN ('ACCEPTED', 'MODIFIED', 'IGNORED')); can ap dung bang SQL rieng.
  ownerDecision         String?   @map("owner_decision") @db.VarChar(30)
  /// SQL CHECK (owner_modified_order_qty >= 0); can ap dung bang SQL rieng.
  ownerModifiedOrderQty Int?      @map("owner_modified_order_qty")
  decisionNotes         String?   @map("decision_notes") @db.Text
  actualRealizedSales   Int?      @map("actual_realized_sales")
  errorAbsoluteQty      Int?      @map("error_absolute_qty")
  evaluatedAt           DateTime? @map("evaluated_at") @db.Timestamptz(6)

  run     ForecastRun    @relation("forecast_results_run_id", fields: [runId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  variant ProductVariant @relation("forecast_results_variant_id", fields: [variantId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("forecast_results")
}

enum StockTransactionType {
  OPENING_STOCK
  PURCHASE_RECEIPT
  POS_SALE
  CUSTOMER_RETURN
  VENDOR_RETURN
  STOCK_ADJUSTMENT_IN
  STOCK_ADJUSTMENT_OUT
  SCRAP_DISPOSAL

  @@map("stock_transaction_type")
}

view ProductLotStatus {
  id                String    @unique @db.Uuid
  businessId        String    @map("business_id") @db.Uuid
  lotId             String    @map("lot_id") @db.Uuid
  variantId         String    @map("variant_id") @db.Uuid
  lotNumber         String    @map("lot_number") @db.VarChar(100)
  manufacturingDate DateTime? @map("manufacturing_date") @db.Date
  expirationDate    DateTime  @map("expiration_date") @db.Date
  alertDaysBefore   Int?      @map("alert_days_before")
  createdAt         DateTime? @map("created_at") @db.Timestamptz(6)
  isExpired         Boolean   @map("is_expired")
  isNearExpiry      Boolean?  @map("is_near_expiry")
  daysRemaining     Int       @map("days_remaining")

  @@map("v_product_lots")
}
