  /// SQL CHECK (unit_cost >= 0); can ap dung bang SQL rieng.
  unitCost            Decimal   @map("unit_cost") @db.Decimal(12, 2)
  /// Plain nullable column in the live database (not generated). Set to scrap_qty * unit_cost when the order is approved.
  totalLossValue      Decimal?  @default(dbgenerated()) @map("total_loss_value") @db.Decimal(14, 2)
  /// SQL CHECK (scrap_source IN ('DAMAGED_STOCK', 'SELLABLE_STOCK')); can ap dung bang SQL rieng.
