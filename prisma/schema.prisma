model StockAudit {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId       String    @map("business_id") @db.Uuid
  auditCode        String    @map("audit_code") @db.VarChar(50)
  /// Set when the counting starts, not when the draft is created.
  countStartAt     DateTime? @map("count_start_at") @db.Timestamptz(6)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)
  /// SQL CHECK (scope_type IN ('FULL_STORE', 'CATEGORY', 'SHELF')); can ap dung bang SQL rieng.
  scopeType        String    @default("FULL_STORE") @map("scope_type") @db.VarChar(30)
  /// Every row counts a lot that is already in the system, so there is only one audit type.
  auditType        String    @default("RE_AUDIT") @map("audit_type") @db.VarChar(30)
  /// A draft locks nothing; the SKUs are locked when the counting starts.
  isLockedForAudit Boolean   @default(false) @map("is_locked_for_audit")
  /// SQL CHECK (status IN ('DRAFT', 'DONE', 'IN_PROGRESS', 'PENDING_APPROVAL', 'APPLIED', 'CANCELLED')); DONE is the terminal status written on apply.
  status           String    @default("DRAFT") @db.VarChar(30)
  approvedBy       String?   @map("approved_by") @db.Uuid
  createdBy        String?   @map("created_by") @db.Uuid

  business        Business         @relation("stock_audits_business_id", fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  approvedByUser  User?            @relation("stock_audits_approved_by", fields: [approvedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdByUser   User?            @relation("stock_audits_created_by", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  stockAuditItems StockAuditItem[] @relation("stock_audit_items_audit_id")

  @@unique([businessId, auditCode], map: "uq_audit_tenant_code")
  @@map("stock_audits")
}

model StockAuditItem {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auditId                 String    @map("audit_id") @db.Uuid
  variantId               String    @map("variant_id") @db.Uuid
  lotItemId               String?   @map("lot_item_id") @db.Uuid
  snapshotQty             Int       @map("snapshot_qty")
  /// SQL CHECK (counted_qty >= 0); can ap dung bang SQL rieng.
  countedQty              Int       @map("counted_qty")
  /// Broken goods found during the count. Added to the balance's damaged_quantity when the audit is applied.
  countedDamagedQty       Int       @default(0) @map("counted_damaged_qty")
  /// SQL GENERATED ALWAYS AS (counted_qty - snapshot_qty) STORED; dbgenerated() chi danh dau gia tri do DB sinh.
  diffQty                 Int?      @default(dbgenerated()) @map("diff_qty")
  discrepancyReason       String?   @map("discrepancy_reason") @db.Text
  /// SQL CHECK (item_status IN ('IN_PROGRESS', 'PENDING_APPROVAL', 'APPROVED')); can ap dung bang SQL rieng.
  itemStatus              String    @default("IN_PROGRESS") @map("item_status") @db.VarChar(30)
  assignedToUserId        String?   @map("assigned_to_user_id") @db.Uuid
  /// The second employee assigned to the same row. When set, the row needs two independent counts.
  secondCounterUserId     String?   @map("second_counter_user_id") @db.Uuid
  submittedAt             DateTime? @map("submitted_at") @db.Timestamptz(6)
  submittedBy             String?   @map("submitted_by") @db.Uuid
  approvedAt              DateTime? @map("approved_at") @db.Timestamptz(6)
  approvedBy              String?   @map("approved_by") @db.Uuid
  /// Set when the owner sends a submitted item back for a recount. Cleared when the employee submits again.
  rejectionReason         String?   @map("rejection_reason") @db.Text
  rejectedAt              DateTime? @map("rejected_at") @db.Timestamptz(6)
  rejectedBy              String?   @map("rejected_by") @db.Uuid
  createdBy               String?   @map("created_by") @db.Uuid
  /// Lot number: autofilled from product_lot_items when lot_item_id is set.
  lotNumber               String?   @map("lot_number") @db.VarChar(100)
  /// Correction of the lot's expiry / manufacturing date, written to the lot item when the audit is applied.
  newLotExpirationDate    DateTime? @map("new_lot_expiration_date") @db.Date
  newLotManufacturingDate DateTime? @map("new_lot_manufacturing_date") @db.Date

  audit           StockAudit      @relation("stock_audit_items_audit_id", fields: [auditId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  variant         ProductVariant  @relation("stock_audit_items_variant_id", fields: [variantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lotItem         ProductLotItem? @relation("stock_audit_items_lot_item_id", fields: [lotItemId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  assignedToUser  User?           @relation("stock_audit_items_assigned_to_user_id", fields: [assignedToUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  secondCounterUser User?         @relation("stock_audit_items_second_counter_user_id", fields: [secondCounterUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  submittedByUser User?           @relation("stock_audit_items_submitted_by_user_id", fields: [submittedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  approvedByUser  User?           @relation("stock_audit_items_approved_by_user_id", fields: [approvedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  rejectedByUser  User?           @relation("stock_audit_items_rejected_by_user_id", fields: [rejectedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdByUser   User?           @relation("stock_audit_items_created_by_user_id", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  counts          StockAuditItemCount[] @relation("stock_audit_item_counts_item_id")
  histories       StockAuditItemHistory[] @relation("stock_audit_item_histories_item_id")

  @@map("stock_audit_items")
}

/// A record of one audit row at one point in time: written when the owner approves, rejects or
/// asks for another count. The row is a copy of the numbers as they were then, not a link to the
/// live row, so the history does not change when the live row does.
model StockAuditItemHistory {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId        String   @map("business_id") @db.Uuid
  itemId            String   @map("item_id") @db.Uuid
  auditId           String   @map("audit_id") @db.Uuid
  /// The nth time this row was recorded. The pair (item, revision) is unique.
  revision          Int
  /// APPROVED | REJECTED | RECOUNT
  action            String   @db.VarChar(30)
  /// Why the owner sent the row back, when they did.
  reason            String?  @db.Text
  /// The owner who made the decision.
  actorId           String   @map("actor_id") @db.Uuid
  /// The row's numbers at the moment of the record.
  snapshotQty       Int      @map("snapshot_qty")
  countedQty        Int      @map("counted_qty")
  countedDamagedQty Int      @map("counted_damaged_qty")
  discrepancyReason String?  @map("discrepancy_reason") @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  business Business              @relation("stock_audit_item_histories_business_id", fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  item     StockAuditItem        @relation("stock_audit_item_histories_item_id", fields: [itemId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  actor    User                  @relation("stock_audit_item_histories_actor_id", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  counts   StockAuditItemHistoryCount[] @relation("stock_audit_item_history_counts_history_id")
  images   StockAuditItemCountImage[] @relation("stock_audit_item_count_images_history_id")

  @@unique([itemId, revision], map: "uq_stock_audit_item_histories_item_revision")
  @@index([businessId, itemId], map: "idx_stock_audit_item_histories_business_item")
  @@map("stock_audit_item_histories")
}

/// What each counter had counted at the moment of the record. Without this the history would only
/// say that the row was sent back, not what the two people had found.
model StockAuditItemHistoryCount {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  historyId         String   @map("history_id") @db.Uuid
  counterUserId     String   @map("counter_user_id") @db.Uuid
  countedQty        Int      @map("counted_qty")
  countedDamagedQty Int      @map("counted_damaged_qty")
  discrepancyReason String?  @map("discrepancy_reason") @db.Text
  submittedAt       DateTime? @map("submitted_at") @db.Timestamptz(6)

  history    StockAuditItemHistory @relation("stock_audit_item_history_counts_history_id", fields: [historyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  counterUser User                 @relation("stock_audit_item_history_counts_counter_user_id", fields: [counterUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([historyId], map: "idx_stock_audit_item_history_counts_history")
  @@map("stock_audit_item_history_counts")
}

/// One employee's own count of a row. Kept apart from the item so the two counters never see
/// each other's number: a row is only comparable once both employees have submitted.
model StockAuditItemCount {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId         String   @map("item_id") @db.Uuid
  counterUserId  String   @map("counter_user_id") @db.Uuid
  countedQty     Int      @default(0) @map("counted_qty")
  countedDamagedQty Int    @default(0) @map("counted_damaged_qty")
  discrepancyReason String? @map("discrepancy_reason") @db.Text
  /// Correction of the lot's expiry / manufacturing date, written to the lot item when the audit is applied.
  newLotExpirationDate    DateTime? @map("new_lot_expiration_date") @db.Date
  newLotManufacturingDate DateTime? @map("new_lot_manufacturing_date") @db.Date
  submittedAt    DateTime? @map("submitted_at") @db.Timestamptz(6)
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  item        StockAuditItem @relation("stock_audit_item_counts_item_id", fields: [itemId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  counterUser User           @relation("stock_audit_item_counts_counter_user_id", fields: [counterUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  images      StockAuditItemCountImage[] @relation("stock_audit_item_count_images_count_id")

  @@unique([itemId, counterUserId], map: "uq_stock_audit_item_counts_item_counter")
  @@index([itemId], map: "idx_stock_audit_item_counts_item")
  @@map("stock_audit_item_counts")
}

/// Evidence photos of one counter's count. They hang off the count row, not the item, because
/// each of the two counters documents their own numbers and must not see the other's photos.
/// Rows are soft-deleted (deleted_at) so removals stay auditable.
model StockAuditItemCountImage {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId   String    @map("business_id") @db.Uuid
  countId      String    @map("count_id") @db.Uuid
  /// The history entry this photo was filed under. Set when the row is approved, rejected or sent
  /// back for another count; the photo then belongs to that moment instead of the live row.
  historyId    String?   @map("history_id") @db.Uuid
  storagePath  String    @map("storage_path") @db.VarChar(500)
  mimeType     String    @map("mime_type") @db.VarChar(50)
  sizeBytes    Int       @map("size_bytes")
  note         String?   @db.VarChar(500)
  uploadedBy   String    @map("uploaded_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy    String?   @map("deleted_by") @db.Uuid
  /// Set when the photo was filed under a history entry. A filed photo is no longer shown in the
  /// live gallery, so old evidence never sits next to fresh numbers.
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(6)

  business       Business             @relation("stock_audit_item_count_images_business_id", fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  count          StockAuditItemCount  @relation("stock_audit_item_count_images_count_id", fields: [countId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  history        StockAuditItemHistory? @relation("stock_audit_item_count_images_history_id", fields: [historyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  uploadedByUser User                 @relation("stock_audit_item_count_images_uploaded_by", fields: [uploadedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  deletedByUser  User?                @relation("stock_audit_item_count_images_deleted_by", fields: [deletedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([businessId, countId], map: "idx_stock_audit_item_count_images_count")
  @@index([historyId], map: "idx_stock_audit_item_count_images_history")
  @@map("stock_audit_item_count_images")
}

model ScrapOrder {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId          String    @map("business_id") @db.Uuid
  scrapCode           String    @map("scrap_code") @db.VarChar(50)
  variantId           String    @map("variant_id") @db.Uuid
  lotItemId           String?   @map("lot_item_id") @db.Uuid
  /// SQL CHECK (scrap_qty > 0); can ap dung bang SQL rieng.
  scrapQty            Int       @map("scrap_qty")
  /// SQL CHECK (unit_cost >= 0); can ap dung bang SQL rieng.
  unitCost            Decimal   @map("unit_cost") @db.Decimal(12, 2)
  /// Plain nullable column in the live database (not generated). Set to scrap_qty * unit_cost when the order is approved.
  totalLossValue      Decimal?  @default(dbgenerated()) @map("total_loss_value") @db.Decimal(14, 2)
  /// SQL CHECK (scrap_source IN ('DAMAGED_STOCK', 'SELLABLE_STOCK')); can ap dung bang SQL rieng.
  scrapSource         String    @default("DAMAGED_STOCK") @map("scrap_source") @db.VarChar(30)
  scrapReason         String    @map("scrap_reason") @db.VarChar(255)
  /// SQL CHECK (status IN ('PENDING', 'COMPLETED', 'REJECTED', 'CANCELLED')); CANCELLED is kept for old rows.
  status              String    @default("PENDING") @db.VarChar(30)
  createdBy           String    @map("created_by") @db.Uuid
  createdAt           DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  approvedBy          String?   @map("approved_by") @db.Uuid
  approvedAt          DateTime? @map("approved_at") @db.Timestamptz(6)
  rejectedBy          String?   @map("rejected_by") @db.Uuid
  rejectedAt          DateTime? @map("rejected_at") @db.Timestamptz(6)
  /// SQL CHECK (rejection_reason_code IN ('WRONG_QUANTITY', 'PHOTO_UNCLEAR', 'NOT_REMOVED_FROM_SHELF', 'OTHER')).
  rejectionReasonCode String?   @map("rejection_reason_code") @db.VarChar(40)
  rejectionNote       String?   @map("rejection_note") @db.VarChar(500)
  /// Set when the Owner closes a PENDING order without approving or rejecting it. The lot stays quarantined.
  cancelledBy         String?   @map("cancelled_by") @db.Uuid
  cancelledAt         DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledNote       String?   @map("cancelled_note") @db.VarChar(500)

  business        Business          @relation("scrap_orders_business_id", fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  variant         ProductVariant    @relation("scrap_orders_variant_id", fields: [variantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lotItem         ProductLotItem?   @relation("scrap_orders_lot_item_id", fields: [lotItemId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdByUser   User              @relation("scrap_orders_created_by", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  approvedByUser  User?             @relation("scrap_orders_approved_by", fields: [approvedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  rejectedByUser  User?             @relation("scrap_orders_rejected_by", fields: [rejectedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  cancelledByUser User?             @relation("scrap_orders_cancelled_by", fields: [cancelledBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  images          ScrapOrderImage[] @relation("scrap_order_images_scrap_order_id")

  @@unique([businessId, scrapCode], map: "uq_scrap_tenant_code")
  @@map("scrap_orders")
}

/// Quarantine state for a product that has no lot item. The quantity pulled off the shelf is
