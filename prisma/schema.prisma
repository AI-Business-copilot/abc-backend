  supplier Supplier?      @relation("ai_replenishment_supplier_id", fields: [supplierId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  po       PurchaseOrder? @relation("ai_replenishment_po_id", fields: [poId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([businessId, variantId], map: "uq_ai_replenishment_variant")
  @@index([businessId, status, urgency], map: "idx_ai_replenishment_status")
  @@map("ai_replenishment_items")
}

model ChannelDailyProductMetric {
  businessId     String   @map("business_id") @db.Uuid
  variantId      String   @map("variant_id") @db.Uuid
  channel        String   @default("POS") @db.VarChar(20)
  metricDate     DateTime @map("metric_date") @db.Date
  unitsSold      Int      @default(0) @map("units_sold")
  unitsReturned  Int      @default(0) @map("units_returned")
  orderCount     Int      @default(0) @map("order_count")
  grossSales     Decimal  @default(0) @map("gross_sales") @db.Decimal(14, 2)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(14, 2)
  refundAmount   Decimal  @default(0) @map("refund_amount") @db.Decimal(14, 2)
  returnedCogs   Decimal  @default(0) @map("returned_cogs") @db.Decimal(14, 2)
  netRevenue     Decimal  @default(0) @map("net_revenue") @db.Decimal(14, 2)
  netCogs        Decimal  @default(0) @map("net_cogs") @db.Decimal(14, 2)
  generatedAt    DateTime @default(now()) @map("generated_at") @db.Timestamptz(6)

  business Business       @relation("channel_daily_metrics_business_id", fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  variant  ProductVariant @relation("channel_daily_metrics_variant_id", fields: [businessId, variantId], references: [businessId, id], onDelete: Restrict, onUpdate: NoAction)

  @@id([businessId, channel, variantId, metricDate])
  @@index([businessId, channel, metricDate], map: "idx_channel_daily_metrics_business_date")
  @@map("channel_daily_product_metrics")
}


enum StockTransactionType {
  OPENING_STOCK
  PURCHASE_RECEIPT
  POS_SALE
  CUSTOMER_RETURN
  VENDOR_RETURN
  STOCK_ADJUSTMENT_IN
  STOCK_ADJUSTMENT_OUT
  SCRAP_DISPOSAL

  @@map("stock_transaction_type")
}

view ProductLotStatus {
  id                String    @unique @db.Uuid
  businessId        String    @map("business_id") @db.Uuid
  lotId             String    @map("lot_id") @db.Uuid
  variantId         String    @map("variant_id") @db.Uuid
  lotNumber         String    @map("lot_number") @db.VarChar(100)
  manufacturingDate DateTime? @map("manufacturing_date") @db.Date
  expirationDate    DateTime  @map("expiration_date") @db.Date
  alertDaysBefore   Int?      @map("alert_days_before")
  createdAt         DateTime? @map("created_at") @db.Timestamptz(6)
  isExpired         Boolean   @map("is_expired")
  isNearExpiry      Boolean?  @map("is_near_expiry")
  daysRemaining     Int       @map("days_remaining")

  @@map("v_product_lots")
}
