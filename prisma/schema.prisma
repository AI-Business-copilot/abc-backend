  /// SQL CHECK (total_amount >= 0); can ap dung bang SQL rieng.
  totalAmount Decimal   @map("total_amount") @db.Decimal(14, 2)
  /// SQL CHECK (paid_amount >= 0); can ap dung bang SQL rieng.
  paidAmount  Decimal   @default(0) @map("paid_amount") @db.Decimal(14, 2)
  /// SQL GENERATED ALWAYS AS (total_amount - paid_amount) STORED; dbgenerated() chi danh dau gia tri do DB sinh.
  debtAmount  Decimal?  @default(dbgenerated()) @map("debt_amount") @db.Decimal(14, 2)
  /// SQL CHECK (status IN ('RECEIVED', 'CANCELLED')); can ap dung bang SQL rieng.
  status      String    @default("RECEIVED") @db.VarChar(30)
  createdBy   String    @map("created_by") @db.Uuid

  business             Business              @relation("purchase_receipts_business_id", fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  po                   PurchaseOrder?        @relation("purchase_receipts_po_id", fields: [poId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  supplier             Supplier              @relation("purchase_receipts_supplier_id", fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdByUser        User                  @relation("purchase_receipts_created_by", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  purchaseReceiptItems PurchaseReceiptItem[] @relation("purchase_receipt_items_receipt_id")
  vendorReturns        VendorReturn[]        @relation("vendor_returns_receipt_id")

  @@unique([businessId, receiptCode], map: "uq_receipt_tenant_code")
  @@map("purchase_receipts")
}

model PurchaseReceiptItem {
