/// Batch header. The batch code only; dates, status and quarantine live on ProductLotItem, one row per variant.
model ProductLot {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  lotNumber  String    @map("lot_number") @db.VarChar(100)
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  business Business         @relation("product_lots_business_id", fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  items    ProductLotItem[] @relation("product_lot_items_lot_id")

  @@unique([businessId, lotNumber], map: "uq_lot_tenant_number")
  @@map("product_lots")
}

/// One variant inside a batch. Expiry, status and quarantine live here because they differ per variant.
model ProductLotItem {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId        String    @map("business_id") @db.Uuid
  lotId             String    @map("lot_id") @db.Uuid
  variantId         String    @map("variant_id") @db.Uuid
  manufacturingDate DateTime? @map("manufacturing_date") @db.Date
  expirationDate    DateTime  @map("expiration_date") @db.Date
  /// SQL CHECK (alert_days_before >= 0); can ap dung bang SQL rieng.
  alertDaysBefore   Int?      @default(30) @map("alert_days_before")
  /// Status: HEALTHY / WARNING / UNUSABLE (calculated from expiration date), QUARANTINED, SCRAPPED
  status            String    @default("HEALTHY") @map("status") @db.VarChar(30)
  isLockedForAudit  Boolean   @default(false) @map("is_locked_for_audit")
  /// Quantity staff pulled off the shelf when quarantining this item. SQL CHECK (quarantine_qty > 0).
  quarantineQty     Int?      @map("quarantine_qty")
  quarantinedAt     DateTime? @map("quarantined_at") @db.Timestamptz(6)
  quarantinedBy     String?   @map("quarantined_by") @db.Uuid
  quarantineNote    String?   @map("quarantine_note") @db.VarChar(500)
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  quarantinedByUser    User?                 @relation("product_lot_items_quarantined_by", fields: [quarantinedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  business             Business              @relation("product_lot_items_business_id", fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lot                  ProductLot            @relation("product_lot_items_lot_id", fields: [lotId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  variant              ProductVariant        @relation("product_lot_items_variant_id", fields: [variantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inventoryBalances    InventoryBalance[]    @relation("inventory_balances_lot_item_id")
  inventoryLedger      InventoryLedger[]     @relation("inventory_ledger_lot_item_id")
  openingStockItems    OpeningStockItem[]    @relation("opening_stock_items_lot_item_id")
  purchaseReceiptItems PurchaseReceiptItem[] @relation("purchase_receipt_items_lot_item_id")
  vendorReturnItems    VendorReturnItem[]    @relation("vendor_return_items_lot_item_id")
  orderItems           OrderItem[]           @relation("order_items_lot_item_id")
  customerReturnItems  CustomerReturnItem[]  @relation("customer_return_items_lot_item_id")
  stockAuditItems      StockAuditItem[]      @relation("stock_audit_items_lot_item_id")
  scrapOrders          ScrapOrder[]          @relation("scrap_orders_lot_item_id")

  @@unique([businessId, lotId, variantId], map: "uq_product_lot_item")
  @@index([businessId, status], map: "idx_product_lot_items_business_status")
  @@index([businessId, expirationDate], map: "idx_product_lot_items_expiration_date")
  @@index([businessId, variantId], map: "idx_product_lot_items_business_variant")
  @@index([lotId], map: "idx_product_lot_items_lot")
  @@map("product_lot_items")
}

model InventoryBalance {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId      String    @map("business_id") @db.Uuid
  variantId       String    @map("variant_id") @db.Uuid
  lotItemId       String?   @map("lot_item_id") @db.Uuid
