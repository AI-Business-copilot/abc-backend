  @@unique([businessId, variantId], map: "uq_inventory_balance_no_lot", where: raw("(lot_item_id IS NULL)"))
  @@unique([businessId, variantId, lotItemId], map: "uq_inventory_balance_with_lot", where: raw("(lot_item_id IS NOT NULL)"))
  @@map("inventory_balances")
}

