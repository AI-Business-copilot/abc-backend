generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Business {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String    @db.VarChar(255)
  phone        String    @db.VarChar(20)
  address      String?   @db.Text
  industryType String    @map("industry_type") @db.VarChar(50)
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships BusinessMembership[]
  invitations BusinessInvitation[]

  @@map("businesses")
}

model User {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authUserId String    @unique(map: "uq_users_auth_user_id") @map("auth_user_id") @db.Uuid
  email      String    @unique(map: "uq_users_email") @db.VarChar(320)
  fullName   String    @map("full_name") @db.VarChar(150)
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships     BusinessMembership[]
  platformRoles   PlatformUserRole[]
  sentInvitations BusinessInvitation[] @relation("business_invitations_invited_by")

  @@map("users")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique(map: "uq_roles_code") @db.VarChar(50)
  scope       String   @db.VarChar(20)
  displayName String   @map("display_name") @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  permissions   RolePermission[]
  memberships   BusinessMembership[]
  platformUsers PlatformUserRole[]
  invitations   BusinessInvitation[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique(map: "uq_permissions_code") @db.VarChar(100)
  scope       String   @db.VarChar(20)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model BusinessMembership {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  userId     String   @unique(map: "uq_business_memberships_user") @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  status     String   @default("ACTIVE") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  role     Role     @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([businessId, userId], map: "uq_business_memberships_business_user")
  @@index([businessId, status], map: "idx_business_memberships_business_status")
  @@map("business_memberships")
}

model PlatformUserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([userId, roleId])
  @@map("platform_user_roles")
}

model BusinessInvitation {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId   String    @map("business_id") @db.Uuid
  invitedEmail String    @map("invited_email") @db.VarChar(320)
  roleId       String    @map("role_id") @db.Uuid
  invitedBy    String    @map("invited_by") @db.Uuid
  tokenHash    String    @unique(map: "uq_business_invitations_token_hash") @map("token_hash") @db.Char(64)
  status       String    @default("PENDING") @db.VarChar(20)
  emailStatus  String    @default("PENDING") @map("email_status") @db.VarChar(20)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt   DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  business      Business @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  role          Role     @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  invitedByUser User     @relation("business_invitations_invited_by", fields: [invitedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([businessId, invitedEmail], where: raw("(status = 'PENDING')"), map: "uq_business_invitations_pending_email")
  @@index([businessId, status], map: "idx_business_invitations_business_status")
  @@index([invitedEmail, status], map: "idx_business_invitations_email_status")
  @@map("business_invitations")
}
