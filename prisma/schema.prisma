model PurchaseOrderItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  poId        String   @map("po_id") @db.Uuid
  variantId   String   @map("variant_id") @db.Uuid
  /// SQL CHECK (ordered_qty > 0); can ap dung bang SQL rieng.
  orderedQty  Int      @map("ordered_qty")
  /// SQL CHECK (received_qty >= 0); can ap dung bang SQL rieng.
  receivedQty Int      @default(0) @map("received_qty")
  /// SQL CHECK (unit_price >= 0); can ap dung bang SQL rieng.
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  /// SQL GENERATED ALWAYS AS (ordered_qty * unit_price) STORED; dbgenerated() chi danh dau gia tri do DB sinh.
  subtotal    Decimal? @default(dbgenerated()) @db.Decimal(14, 2)

  po                   PurchaseOrder         @relation("purchase_order_items_po_id", fields: [poId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  variant              ProductVariant        @relation("purchase_order_items_variant_id", fields: [variantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  purchaseReceiptItems PurchaseReceiptItem[] @relation("purchase_receipt_items_po_item_id")

  // SQL CONSTRAINT chk_received_not_exceed_ordered CHECK (received_qty <= ordered_qty); can ap dung bang SQL rieng.
  @@map("purchase_order_items")
}

model PurchaseReceipt {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String    @map("business_id") @db.Uuid
  receiptCode String    @map("receipt_code") @db.VarChar(50)
  poId        String?   @map("po_id") @db.Uuid
  supplierId  String    @map("supplier_id") @db.Uuid
