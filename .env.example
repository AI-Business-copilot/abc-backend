PORT=5000
# For an IPv4-only network, copy the Session pooler URI from Supabase Dashboard > Connect.
# Keep the exact pooler host, username, and port from Supabase; do not construct them manually.
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[YOUR-POOLER-HOST]:5432/postgres"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[YOUR-POOLER-HOST]:5432/postgres"
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="[YOUR-SUPABASE-PUBLISHABLE-OR-ANON-KEY]"
# Server only. Never expose this key to the frontend.
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SUPABASE-SECRET-OR-SERVICE-ROLE-KEY]"
SUPABASE_AUTH_REDIRECT_URL="http://localhost:5173/auth/callback"
# Optional: only the verified account matching this email is bootstrapped as SYSTEM_ADMIN.
SYSTEM_ADMIN_EMAIL=""
# Private Supabase Storage bucket for scrap order evidence photos. Created on first upload if missing.
SUPABASE_STORAGE_BUCKET="scrap-evidence"
